<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginFragment">

    <!-- TODO: Update blank fragment layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/btnLoginLogin"
            android:layout_width="167dp"
            android:layout_height="49dp"
            android:layout_marginStart="139dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="312dp"
            android:text="Login"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etPasswordLogin"
            app:layout_constraintVertical_bias="0.0" />

        <EditText
            android:id="@+id/etPasswordLogin"
            android:layout_width="275dp"
            android:layout_height="60dp"
            android:layout_marginStart="43dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="376dp"
            android:ems="10"
            android:hint="Your Password"
            android:inputType="textPassword"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etUsernameLogin" />

        <EditText
            android:id="@+id/etUsernameLogin"
            android:layout_width="275dp"
            android:layout_height="60dp"
            android:layout_marginStart="43dp"
            android:layout_marginTop="216dp"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="40dp"
            android:ems="10"
            android:hint="Your username"
            android:inputType="textEmailAddress"
            app:layout_constraintBottom_toTopOf="@+id/etPasswordLogin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSignUpLinkLogin"
            android:layout_width="83dp"
            android:layout_height="40dp"
            android:layout_marginStart="43dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="25dp"
            android:layout_marginBottom="321dp"
            android:text="Click here to sign up"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnLoginLogin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etPasswordLogin" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>